# ==============================================================================
# LEARNIFY AI / MYRAA AI GATEWAY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env or .env.local:
#    cp .env.example .env
# 2. Populate with your private environment credentials.
# 3. NEVER commit real secrets, API keys, or service role tokens to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
VITE_SITE_URL=https://www.learnifyai.in
APP_URL=https://www.learnifyai.in

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, AUTH, STORAGE)
# ------------------------------------------------------------------------------
# Public client variables (exposed to browser):
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Server-side only (NEVER expose to frontend):
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ------------------------------------------------------------------------------
# 3. MYRAA AI GATEWAY & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Primary High-Throughput / Fast Inference Provider:
GROQ_API_KEY=<your-groq-api-key>

# Primary Multimodal / Long-Context / Google Gemini Provider:
GEMINI_API_KEY=<your-gemini-api-key>

# Unified Multi-Model Gateway & Coding Fallbacks:
OPENROUTER_API_KEY=<your-openrouter-api-key>

# NVIDIA NIM / Specialist Reasoning (Optional):
NVIDIA_API_KEY=<your-nvidia-api-key>

# Local Offline Inference (Optional, for local Ollama / vLLM):
# OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 4. IMAGE GENERATION ENGINE (STABLE DIFFUSION / HOSTED)
# ------------------------------------------------------------------------------
# Image Generation Provider Selection: 'gemini' | 'huggingface' | 'local_sd' | 'replicate'
IMAGE_PROVIDER=gemini
# Hugging Face Inference API Token (if using hosted Stable Diffusion / FLUX):
HUGGINGFACE_API_KEY=<your-huggingface-token>
# Local Stable Diffusion API endpoint (e.g., Automatic1111 / ComfyUI / diffusers service):
# LOCAL_SD_ENDPOINT=http://127.0.0.1:7860

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED CACHE & RATE LIMITING (UPSTASH REDIS)
# ------------------------------------------------------------------------------
# Upstash REST API credentials (recommended for Vercel Serverless / Edge):
UPSTASH_REDIS_REST_URL=https://<your-redis-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-redis-token>

# ------------------------------------------------------------------------------
# 6. INDIAN PAYMENT GATEWAYS (CASHFREE & RAZORPAY)
# ------------------------------------------------------------------------------
# Active gateway selector: 'cashfree' | 'razorpay'
ACTIVE_PAYMENT_GATEWAY=cashfree

# Cashfree Payments (Primary for Subscriptions, UPI, Payouts):
CASHFREE_APP_ID=<your-cashfree-app-id>
CASHFREE_SECRET_KEY=<your-cashfree-secret-key>
# Environment: 'TEST' for sandbox, 'PRODUCTION' for live
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01

# Razorpay (Secondary / Alternate Gateway):
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>

# ------------------------------------------------------------------------------
# 7. EMAIL & TRANSACTIONAL NOTIFICATIONS (RESEND / SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=notifications@learnifyai.in
SUPPORT_EMAIL=support@learnifyai.in

# ------------------------------------------------------------------------------
# 8. CRON & INTERNAL AUTOMATION SECURITY
# ------------------------------------------------------------------------------
# Shared secret for authenticating automated cron job executions:
CRON_SECRET=<generate-random-secret-for-cron-endpoints>
